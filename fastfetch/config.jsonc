{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Pictures/Wallpapers/sans.png",
        "type": "auto",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 0,
            "right": 2,
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "34",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34",
            "format": "{2}"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "34",
            "format": "{1}"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
