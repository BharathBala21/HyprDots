{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Pictures/sans.png",
    "type": "auto",
    "width": 20,
    "height": 10,
    "padding": {
      "top": 0,
      "right": 2,
      "left": 1
    },
    "color": {
      "1": "#63d2cf",
      "2": "#63ccca"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    },
    "color": {
      "keys": "#90d2cf",
      "title": "#b2ccca"
    },
    "percent": {
      "color": {
        "green": "#d5bcf2",
        "yellow": "#90d2cf",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "34",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "34",
      "format": "{2}"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "datetime",
      "format": "{1}-{3}-{11}",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "player",
      "key": " ",
      "keyColor": "34"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
