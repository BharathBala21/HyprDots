{
  "$schema": "https://docs.page/schema.json",
  "name": "HyprDots",
  "description": "Curated Arch Linux + Hyprland dotfiles with Matugen theming and Tide Island widgets.",
  "theme": {
    "defaultTheme": "dark",
    "preset": "slate",
    "primary": "#7C88FF",
    "primaryLight": "#A9B4FF",
    "primaryDark": "#4654C8",
    "backgroundLight": "#F7F9FF",
    "backgroundDark": "#080A14"
  },
  "header": {
    "showName": true,
    "showThemeToggle": true,
    "showGitHubCard": true,
    "links": [
      { "title": "GitHub", "href": "https://github.com/BharathBala21/HyprDots", "cta": true },
      { "title": "Ask AI", "href": "/ask-ai", "cta": true },
      { "title": "Installation", "href": "/installation" },
      { "title": "Configuration", "href": "/configuration" }
    ]
  },
  "social": { "github": "https://github.com/BharathBala21/HyprDots" },
  "seo": { "noindex": false },
  "banner": {},
  "favicon": "",
  "og": { "github": true },
  "mcp": { "enabled": true },
  "anchors": [],
  "variables": {},
  "search": { "docsearch": { "appId": "", "apiKey": "", "indexName": "" } },
  "scripts": {},
  "content": {
    "headerDepth": 3,
    "zoomImages": false,
    "automaticallyInferNextPrevious": true,
    "showPageTitle": true,
    "showPageImage": true
  },
  "tabs": [],
  "sidebar": [
    {
      "group": "Getting Started",
      "pages": [
        { "title": "Home", "href": "/", "icon": "rocket" },
        { "title": "Installation", "href": "/installation", "icon": "download" },
        { "title": "Configuration", "href": "/configuration", "icon": "settings" },
        { "title": "Keybindings", "href": "/keybindings", "icon": "keyboard" }
      ]
    },
    {
      "group": "Configure",
      "pages": [
        { "title": "Customization", "href": "/customization", "icon": "wrench" },
        { "title": "Repository Structure", "href": "/structure", "icon": "folder" },
        { "title": "Features", "href": "/features", "icon": "sparkles" }
      ]
    },
    {
      "group": "Support",
      "pages": [
        { "title": "Troubleshooting", "href": "/troubleshooting", "icon": "warning" },
        { "title": "Next Steps", "href": "/next-steps", "icon": "arrow-right" }
      ]
