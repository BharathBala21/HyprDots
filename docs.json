{
  "$schema": "https://docs.page/schema.json",
  "name": "HyerDOTS",
  "description": "Curated Arch Linux + Hyprland dotfiles with Matugen theming and Tide Island widgets.",
  "theme": {
    "defaultTheme": "dark",
    "preset": "slate",
    "primary": "#7C88FF",
    "primaryLight": "#A9B4FF",
    "primaryDark": "#4654C8",
    "backgroundLight": "#F7F9FF",
    "backgroundDark": "#080A14"
  },
  "header": {
    "showName": true,
    "showThemeToggle": true,
    "showGitHubCard": true,
    "links": [
      {
        "title": "GitHub",
        "href": "https://github.com/BharathBala21/HyprDots",
        "cta": true
      },
      {
        "title": "Installation",
        "href": "/installation"
      },
      {
        "title": "Configuration",
        "href": "/configuration"
      }
    ]
  },
  "social": {
    "github": "https://github.com/BharathBala21/HyprDots"
  },
  "seo": {
    "noindex": false
  },
  "banner": {},
  "favicon": "",
  "og": {
    "github": true
  },
  "agent": {
    "key": "",
    "placeholder": "Ask about HyerDOTS setup and configuration...",
    "questions": [],
    "limits": {
      "ip": 200,
      "repo": 10000
    }
  },
  "mcp": {
    "enabled": true
  },
  "anchors": [],
  "variables": {},
  "search": {
    "docsearch": {
      "appId": "",
      "apiKey": "",
      "indexName": ""
    }
  },
  "scripts": {},
  "content": {
    "headerDepth": 3,
    "zoomImages": false,
    "automaticallyInferNextPrevious": true,
    "showPageTitle": true,
    "showPageImage": true
  },
  "tabs": [],
  "sidebar": [
    {
      "group": "Getting Started",
      "pages": [
        {
          "title": "Home",
          "href": "/",
          "icon": "rocket"
        },
        {
          "title": "Installation",
          "href": "/installation",
          "icon": "download"
        },
        {
          "title": "Configuration",
          "href": "/configuration",
          "icon": "settings"
        }
      ]
    },
    {
      "group": "Configure",
      "pages": [
